<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LAST WATCHED"
        android:textColor="@color/widget_label"
        android:textSize="10sp"
        android:letterSpacing="0.08" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Oppenheimer"
        android:textColor="@color/widget_title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="9.25 / 10   ·   yesterday"
        android:textColor="@color/widget_meta"
        android:textSize="13sp"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Next up: Sicario"
        android:textColor="@color/widget_label"
        android:textSize="11sp"
        android:maxLines="1" />
</LinearLayout>
